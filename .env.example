# Simple AI Chat UI の環境変数のひな形
#
# 使い方：このファイルをコピーして .env.local を作り、値を自分のものに置き換える
#   cp .env.example .env.local
# .env.local は .gitignore で除外されているため、GitHubには公開されない。
# このファイル（.env.example）はGitHubで共有するため、本物の値は絶対に書かないこと。
# 本番環境（Vercel）では、同じ3つをVercelの Environment Variables に登録する。

# Claude APIのキー（Claude Consoleで作成）。サーバー側だけで使い、ブラウザには渡さない
ANTHROPIC_API_KEY=your_anthropic_api_key

# ログイン画面で入力する合言葉。長く推測されにくいものにする
APP_PASSWORD=your_secure_app_password

# ログイン状態（cookie）に署名するための秘密の鍵。32文字以上が必須
# （32文字未満または未設定の場合、安全のため誰もログインできない）
# 下のダミー値は32文字以上あるため動いてしまうが、公開されている値なので必ず置き換えること。
# 次のコマンドでランダムな値を作れる：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# 回数制限（10分間に5回）用のUpstash Redis（ローカルでは不要。設定しなければ制限がかからない）
# 本番（Vercel）では、Upstash Redisを連携すると自動で登録される。ローカルで試すときだけ#を外して値を入れる
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
